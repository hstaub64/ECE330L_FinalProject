/* Add_Boats_To_Display - writes boat positions into the Game_Display buffer
   Called by Layered_Display in Display_Mode 0 (P1 placement) and 1 (P2 placement)
   For each of the 8 digit positions, checks all 7 segment slots in the map struct
   If a boat segment exists at that position, sets the corresponding bit in Game_Display
   This produces a steady full-brightness display of all placed boats */
void Add_Boats_To_Display(map_t boats)
{
    for (int i = 0; i < 8; i++)
    {
        /* Horizontal segments - stored in horizontal[row][digit]
           Row 0 = top (a segment = bit 0)
           Row 1 = middle (g segment = bit 6)
           Row 2 = bottom (d segment = bit 3) */
        if (boats.horizontal[0][i]) Game_Display[i] |= (1<<0);  // top segment
        if (boats.horizontal[1][i]) Game_Display[i] |= (1<<6);  // middle segment
        if (boats.horizontal[2][i]) Game_Display[i] |= (1<<3);  // bottom segment

        /* Vertical segments - stored in vertical[row][index]
           Indices 0-7:  upper row of vertical segments (f and b)
           Indices 8-15: lower row of vertical segments (e and c)
           vertical[0] = left side (f upper-left, e lower-left)
           vertical[1] = right side (b upper-right, c lower-right) */
        if (boats.vertical[0][i])     Game_Display[i] |= (1<<5);  // upper-left (f)
        if (boats.vertical[1][i])     Game_Display[i] |= (1<<4);  // lower-left (e)
        if (boats.vertical[0][i + 8]) Game_Display[i] |= (1<<1);  // upper-right (b)
        if (boats.vertical[1][i + 8]) Game_Display[i] |= (1<<2);  // lower-right (c)
    }
}

/* Add_Shots_To_Display - renders the shot and boat maps during attack phase
   Called by Layered_Display in Display_Mode 2 (P1 attacking) and 3 (P2 attacking)
   For each position where a shot has been fired:
     HIT:  boat segment exists at shot position = segment always ON = 100% brightness
     MISS: no boat at shot position = segment ON only when ramp < 85 = 33% brightness
   ramp is an unsigned char cycling 0-255 at ~820Hz from TIM7
   When ramp < 85: segment is ON  (33% of the 0-255 range)
   When ramp >= 85: segment is OFF (67% of the 0-255 range)
   This creates a smooth dim glow for misses vs bright for hits */
void Add_Shots_To_Display(map_t shots, map_t boats)
{
    for (int i = 0; i < 8; i++)
    {
        /* Horizontal top segment (a):
           Full bright if this was a hit (boat exists here)
           33% dim if this was a miss (no boat, but shot was fired) */
        if (shots.horizontal[0][i])
            if (boats.horizontal[0][i] || ramp < 85)
                Game_Display[i] |= (1<<0);

        /* Horizontal middle segment (g) */
        if (shots.horizontal[1][i])
            if (boats.horizontal[1][i] || ramp < 85)
                Game_Display[i] |= (1<<6);

        /* Horizontal bottom segment (d) */
        if (shots.horizontal[2][i])
            if (boats.horizontal[2][i] || ramp < 85)
                Game_Display[i] |= (1<<3);

        /* Vertical upper-left segment (f) */
        if (shots.vertical[0][i])
            if (boats.vertical[0][i] || ramp < 85)
                Game_Display[i] |= (1<<5);

        /* Vertical lower-left segment (e) */
        if (shots.vertical[1][i])
            if (boats.vertical[1][i] || ramp < 85)
                Game_Display[i] |= (1<<4);

        /* Vertical upper-right segment (b) */
        if (shots.vertical[0][i + 8])
            if (boats.vertical[0][i + 8] || ramp < 85)
                Game_Display[i] |= (1<<1);

        /* Vertical lower-right segment (c) */
        if (shots.vertical[1][i + 8])
            if (boats.vertical[1][i + 8] || ramp < 85)
                Game_Display[i] |= (1<<2);
    }
}

/* Layered_Display - rebuilds the Game_Display buffer and writes one digit to hardware
   This function implements the "photoshop layering" approach from the whiteboard:
     Layer 1 (bottom): boats or shots depending on Display_Mode
     Layer 2 (top):    cursor blink overlaid on top of everything

   Uses display multiplexing: each call writes exactly ONE digit to GPIOE
   display_digit cycles 0-7 so over 8 consecutive calls all digits are refreshed
   Called every 1ms from SysTick giving 125Hz per-digit refresh rate
   At 125Hz the multiplexing is invisible to the human eye (above 60Hz threshold)

   Also serves as the PWM timing reference for dimming:
   Since ramp increments in TIM7 at ~820Hz and Layered_Display runs at 1000Hz,
   the brightness comparison (ramp < 85) produces smooth 33% duty cycle dimming */
void Layered_Display(void)
{
    /* Clear display buffer before rebuilding - prevents stale data accumulating */
    for (int i = 0; i < 8; i++)
        Game_Display[i] = 0;

    /* Layer 1: fill buffer based on current game phase */
    if (Display_Mode == 0)
        Add_Boats_To_Display(Player_Map);    // P1 placement: show P1's boats

    else if (Display_Mode == 1)
        Add_Boats_To_Display(Player2_Map);   // P2 placement: show P2's boats

    else if (Display_Mode == 2)
        Add_Shots_To_Display(P1_Hits, Player2_Map);  // P1 attacking: P1's shots on P2's board

    else if (Display_Mode == 3)
        Add_Shots_To_Display(P2_Hits, Player_Map);   // P2 attacking: P2's shots on P1's board

    /* Layer 2: overlay cursor blink on top of boats/shots
       Only draws cursor when both Cursor_On and Cursor_Visible are true
       Cursor_Visible toggles every 500ms creating the blinking effect
       During doubles placement, Cursor_Segment2 draws the second segment
       so both segments of the double boat blink together */
    if (Cursor_On && Cursor_Visible)
    {
        Game_Display[Cursor_Digit] |= Cursor_Segment;   // primary cursor segment
        if (Cursor_Segment2)
            Game_Display[Cursor_Digit] |= Cursor_Segment2;  // second segment for double boats
    }

    /* Write current digit to GPIOE hardware (multiplexed 7-segment display)
       Lower 8 bits of GPIOE = segment data from Game_Display
       Upper 8 bits of GPIOE = digit select (active-low: 0 = digit ON)
       0xFF00 sets all digit selects HIGH (all off) then we pull one LOW */
    GPIOE->ODR = 0xFF00 | ((unsigned char)Game_Display[display_digit]);

    /* Pull the active digit select pin LOW to turn that digit ON
       display_digit+8 because digit select pins start at GPIOE bit 8 */
    GPIOE->ODR &= ~(1 << (display_digit + 8));

    /* Advance to next digit, wrap back to 0 after digit 7 */
    display_digit++;
    if (display_digit >= 8)
        display_digit = 0;
}

/* SysTick_Handler - fires every 1ms (configured by HAL_Init for 1000Hz)
   This is the heartbeat of the display system - handles two modes:

   Mode 1 (Cursor_On > 0): active during ship placement and attack phases
     - Increments Cursor_Blink_Count every ms
     - Toggles Cursor_Visible every 500ms to create cursor blink effect
     - Calls Layered_Display every ms to refresh display and drive PWM dimming

   Mode 2 (Animate_On > 0): active during message scrolling
     - Counts up to Delay_msec (200ms) then advances message by one character
     - Writes 8 consecutive characters from Message_Pointer to the 8 displays
     - Wraps back to start when end of message is reached */
void SysTick_Handler(void)
{
    /* USER CODE BEGIN SysTick_IRQn 0 */

    if (Cursor_On > 0)
    {
        /* Increment blink counter every 1ms */
        Cursor_Blink_Count++;

        /* Toggle cursor visibility every 500ms = 2Hz blink rate
           This makes the cursor clearly visible as a blinking indicator */
        if (Cursor_Blink_Count >= 500)
        {
            Cursor_Blink_Count = 0;
            Cursor_Visible ^= 1;  // XOR with 1 to toggle between 0 and 1
        }

        /* Refresh display every 1ms
           Each call writes one digit (multiplexing) and evaluates ramp<85
           for PWM dimming of missed shots during attack phase */
        Layered_Display();
    }
    else if (Animate_On > 0)
    {
        /* Increment scroll delay counter every 1ms */
        Delay_counter++;

        /* When counter reaches Delay_msec (200ms), advance message by one step */
        if (Delay_counter > Delay_msec)
        {
            Delay_counter = 0;  // reset counter for next scroll step

            /* Write 8 consecutive message characters to the 8 displays
               Message_Pointer points to current scroll position
               Offsets 0-7 fill digits 7 down to 0 (right to left display order) */
            Seven_Segment_Digit(7, *(Message_Pointer),     0);
            Seven_Segment_Digit(6, *(Message_Pointer + 1), 0);
            Seven_Segment_Digit(5, *(Message_Pointer + 2), 0);
            Seven_Segment_Digit(4, *(Message_Pointer + 3), 0);
            Seven_Segment_Digit(3, *(Message_Pointer + 4), 0);
            Seven_Segment_Digit(2, *(Message_Pointer + 5), 0);
            Seven_Segment_Digit(1, *(Message_Pointer + 6), 0);
            Seven_Segment_Digit(0, *(Message_Pointer + 7), 0);

            /* Advance pointer one position to scroll the message */
            Message_Pointer++;

            /* Wrap back to start when we reach the end of the message
               Subtract 8 to account for the 8-wide display window
               This prevents reading past the end of the message array */
            if ((Message_Pointer - Save_Pointer) >= (Message_Length - 8))
                Message_Pointer = Save_Pointer;
        }
    }

    /* USER CODE END SysTick_IRQn 0 */

    /* Required HAL call - maintains the HAL tick counter used by HAL_Delay
       Must be called every SysTick interrupt or HAL_Delay will not work */
    HAL_IncTick();
}

/* TIM7_IRQHandler - fires at high rate set by TIM7->PSC and TIM7->ARR in main()
   With PSC=199 and ARR=1 on 84MHz APB1 clock:
     Timer clock = 84MHz / (199+1) = 420kHz
     Interrupt rate = 420kHz / (1+1) = 210kHz
     ramp cycles 0-255: 210kHz / 256 = ~820Hz cycle rate

   ramp is used in Add_Shots_To_Display:
     Segment ON  when ramp < 85  (33% of 256 values = 33% duty cycle = dim)
     Segment OFF when ramp >= 85 (67% of 256 values)
   At 820Hz this is well above the flicker threshold so misses appear
   as a steady dim glow rather than visible flashing */
void TIM7_IRQHandler(void)
{
    /* USER CODE BEGIN TIM7_IRQn 0 */

    /* Increment ramp - automatically wraps 255->0 because ramp is unsigned char */
    ramp++;

    /* USER CODE END TIM7_IRQn 0 */

    /* Required HAL call - processes the TIM7 update interrupt flag
       Must be called or TIM7 will keep firing the same interrupt */
    HAL_TIM_IRQHandler(&htim7);
}

/* OTG_FS_IRQHandler - USB On-The-Go Full Speed interrupt handler
   Required by the USB host middleware included in the project
   Not used for game functionality */
void OTG_FS_IRQHandler(void)
{
    HAL_HCD_IRQHandler(&hhcd_USB_OTG_FS);
}
