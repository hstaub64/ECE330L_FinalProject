/* ---- Game Map Structures ----
   map_t contains horizontal[3][8] and vertical[2][16]
   These four maps store all boat and shot data for both players:

   Player_Map:  Player 1's boat positions (1=boat segment, 0=empty)
   Player2_Map: Player 2's boat positions (1=boat segment, 0=empty)
   P1_Hits:     Where Player 1 has fired shots (1=fired, 0=not fired)
   P2_Hits:     Where Player 2 has fired shots (1=fired, 0=not fired)

   During attack phase, Add_Shots_To_Display compares hits against boats:
     shot AND boat = HIT  = segment always ON (full brightness)
     shot, no boat = MISS = segment dim at 33% via ramp PWM */
map_t Player_Map  = {0};
map_t Player2_Map = {0};
map_t P1_Hits     = {0};
map_t P2_Hits     = {0};

/* Display_Mode - tells Layered_Display which maps to render each frame
   0 = Player 1's boats only          (case 1: P1 placing ships)
   1 = Player 2's boats only          (case 2: P2 placing ships)
   2 = P1's shots on P2's board       (cases 3/4: P1 attacking)
   3 = P2's shots on P1's board       (cases 5/6: P2 attacking) */
int Display_Mode = 0;

/* ---- Cursor Variables ----
   The blinking cursor shows the player where their next boat/shot will land
   Written from main.c via extern declarations in main.h
   Read and acted on here in SysTick and Layered_Display */

/* Cursor_On: 1=cursor active and blinking, 0=cursor hidden
   Set to 1 during ship placement and attack phases
   Set to 0 during message scrolling and win screen */
char Cursor_On      = 0;

/* Cursor_Digit: which of the 8 seven-segment displays (0-7, left to right)
   Set each loop iteration by PA1 potentiometer in main.c */
int  Cursor_Digit   = 0;

/* Cursor_Segment: bitmask of which segment within the digit to highlight
   Bit values match 7-segment display wiring:
     bit 0 (0x01) = top segment (a)
     bit 1 (0x02) = upper-right segment (b)
     bit 2 (0x04) = lower-right segment (c)
     bit 3 (0x08) = bottom segment (d)
     bit 4 (0x10) = lower-left segment (e)
     bit 5 (0x20) = upper-left segment (f)
     bit 6 (0x40) = middle segment (g) */
char Cursor_Segment = 0x01;

/* Cursor_Segment2: second segment bitmask for double boat preview
   During double boat placement both segments blink simultaneously
   Set to same bitmask as Cursor_Segment (different segment of same digit)
   0 = no second segment (singles mode and attack mode) */
char Cursor_Segment2 = 0;

/* Cursor_Visible: current blink state, toggled every 500ms
   1 = cursor segments drawn into Game_Display this frame
   0 = cursor segments not drawn (appears off = blink effect) */
char Cursor_Visible = 0;

/* Cursor_Blink_Count: millisecond counter for 500ms blink timing
   Incremented every SysTick call (every 1ms)
   Resets and toggles Cursor_Visible when it reaches 500 */
int  Cursor_Blink_Count = 0;

/* ---- Display Buffer ----
   Game_Display[8]: one byte per seven-segment digit (digits 0-7)
   Each bit in the byte corresponds to one segment of that digit
   Built fresh each frame by Layered_Display from the current maps
   display_digit: which digit is currently being written to hardware
   Cycles 0-7 each call to multiplex all 8 digits over time */
char Game_Display[8] = {0,0,0,0,0,0,0,0};
static int display_digit = 0;

/* USER CODE END PV */

extern HCD_HandleTypeDef hhcd_USB_OTG_FS;
extern TIM_HandleTypeDef htim7;

